{
  "name": "luvreno-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/gen-icons.mjs",
    "build": "node scripts/gen-icons.mjs && tsc -b && vite build && node scripts/postbuild.mjs && node scripts/check-prices.mjs && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:prices": "node scripts/check-prices.mjs",
    "check:external": "node scripts/check-external.mjs",
    "check:php": "node scripts/check-php.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:dashes && npm run check:placeholders && npm run test && npm run build && npm run check:links && npm run check:contrast && npm run check:php && npm run check:dashes",
    "e2e": "npm run build && npm run build:e2e && node scripts/e2e.mjs",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "e2e:run": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "framer-motion": "^14.9.1",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "marked": "^18.1.3",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
